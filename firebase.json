{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "autisolve",
          "appId": "1:991889835279:android:c4af4c5499d37ef917ea7a",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "autisolve",
          "configurations": {
            "android": "1:991889835279:android:c4af4c5499d37ef917ea7a",
            "web": "1:991889835279:web:fae120127c3eeb2d17ea7a"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
